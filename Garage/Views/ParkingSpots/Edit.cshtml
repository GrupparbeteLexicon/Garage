@model Garage.Models.ParkingSpot

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>ParkingSpot</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ParkedVehicleID" class="control-label"></label>
                <input asp-for="ParkedVehicleID" class="form-control" />
                <span asp-validation-for="ParkedVehicleID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ParkingSpotSize" class="control-label"></label>
                <input asp-for="ParkingSpotSize" class="form-control" />
                <span asp-validation-for="ParkingSpotSize" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Blocked" /> @Html.DisplayNameFor(model => model.Blocked)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ParkTime" class="control-label"></label>
                <input asp-for="ParkTime" class="form-control" />
                <span asp-validation-for="ParkTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

