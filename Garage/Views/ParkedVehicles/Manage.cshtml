@using Garage.Extensions
@model IEnumerable<Garage.ViewModels.ManageVehicleViewModel>;

@{
    ViewData["Title"] = "Manage Parked Vehicles";
}

<h1>@ViewData["Title"]</h1>

<div class="d-flex flex-column gap-2">
    <div class="d-flex flex-column flex-md-row align-items-center gap-2">
        <!-- Search form -->
        <form class="d-flex w-50 ms-auto" method="get">
            <!-- Här la vi till ms-auto -->
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       name="search"
                       placeholder="Search registration..."
                       value="@Context.Request.Query["search"]"
                       @(!Model.Any() && string.IsNullOrWhiteSpace(ViewData["Search"] as string) ? "disabled" : "") />

                <select class="form-select"
                        name="vehicleTypeId">
                    <option value="">All vehicle types</option>

                    @foreach (var type in (IEnumerable<VehicleType>)ViewData["VehicleTypes"]!)
                    {
                        <option value="@type.Id"
                                selected="@(ViewData["Type"] != null && (int)ViewData["Type"] == type.Id)">
                            @type.Name
                        </option>
                    }
                </select>

                <button type="submit"
                        class="btn btn-primary"
                        @(!Model.Any() && string.IsNullOrWhiteSpace(ViewData["Search"] as string) ? "disabled" : "")>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(ViewData["Search"] as string) && ViewData["Type"] == null ? "disabled" : "")">
                    Clear
                </a>
            </div>
        </form>

    </div>


    @Html.Partial("~/Views/Partials/Validation.cshtml")

</div>

<table class="table table-striped my-5">
    <thead>
        <tr>
            <td scope="col">
                @Html.DisplayNameFor(model => model.Owner)
            </td>
            <th scope="col">
                @Html.DisplayNameFor(model => model.VehicleType)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Registration)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.ParkingSpot)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.ParkTime)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.ParkedDuration)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Owner)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VehicleType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Registration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkingSpot)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkedDuration)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Unpark" asp-route-id="@item.Id">Checkout</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    @if (string.IsNullOrWhiteSpace(ViewData["Search"] as string))
    {
        <p class="text-muted">No vehicles currently parked.</p>
    }
    else
    {
        <p class="text-muted">No vehicles matched your search.</p>
    }
}
