@using Garage.Extensions
@using Garage.ViewModels
@model VehicleTypeViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Add Vehicle Type</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddVehicleType">
            <partial name="_AddVehicleTypeForm" model="Model" />
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-primary my-3" />
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-action="VehicleTypes">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
