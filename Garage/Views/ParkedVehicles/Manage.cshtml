@using Garage.Extensions
@model Garage.ViewModels.ManageViewModel;

@{
    ViewData["Title"] = "Manage Parked Vehicles";
}

<h1>@ViewData["Title"]</h1>

<div class="d-flex flex-column gap-2">
    <div class="d-flex flex-column flex-md-row align-items-center gap-2">
        <!-- Search form -->
        <form class="d-flex w-50 ms-auto" method="get">
            <!-- Här la vi till ms-auto -->
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       name="search"
                       placeholder="Search registration..."
                       value="@Context.Request.Query["search"]"
                       @(!Model.Vehicles.Any() && string.IsNullOrWhiteSpace(Model.Search) ? "disabled" : "") />

                <select asp-for="VehicleTypeId" asp-items="Model.VehicleTypeList" class="form-select">
                    <option value="0" selected disabled>--- Search by vehicle type ---</option>
                </select>

                <button type="submit"
                        class="btn btn-primary"
                        @(!Model.Vehicles.Any() && string.IsNullOrWhiteSpace(Model.Search) ? "disabled" : "")>
                    Search
                </button>

                <a asp-action="Manage"
                   class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(Model.Search) && Model.VehicleTypeId == null ? "disabled" : "")">
                    Clear
                </a>
            </div>
        </form>

    </div>


    @Html.Partial("~/Views/Partials/Validation.cshtml")

</div>

<table class="table table-striped my-5">
    <thead>
        <tr>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].Owner)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].VehicleType)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].Registration)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].ParkingSpot)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].ParkTime)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Vehicles[0].ParkedDuration)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Vehicles)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Owner)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VehicleType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Registration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkingSpot)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ParkedDuration)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Unpark" asp-route-id="@item.Id">Checkout</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Vehicles.Any())
{
    @if (string.IsNullOrWhiteSpace(Model.Search))
    {
        <p class="text-muted">No vehicles currently parked.</p>
    }
    else
    {
        <p class="text-muted">No vehicles matched your search.</p>
    }
}
